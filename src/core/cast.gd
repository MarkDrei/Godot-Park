## Random visitor definition.
## What a person says when chatting ("Plaudern", chats between people): their own lines, or
## the common small talk for visitors.
static func smalltalk(d: Dictionary) -> Array:
	return d.get("smalltalk", Activities.Chat.SMALLTALK)


## The person who works at shop `shop_id` ("" for machines).
static func vendor_of(shop_id: String) -> String:
	for list: Array in [PEOPLE, FOREST, CITY, FAIR, BURG]:
		for d: Dictionary in list:
			var w: Dictionary = d.get("work", {})
			if w.get("shop", "") == shop_id:
				return d["id"]
	return ""


static func visitor(i: int, rng: RandomNumberGenerator) -> Dictionary:
	var name: String = VISITOR_NAMES[i % VISITOR_NAMES.size()]
	var female := i % 2 == 0
	var tops := ["tshirt", "shirt", "hoodie", "jacket", "dress" if female else "tshirt"]
	var hairs := ["long", "bob", "ponytail", "bun", "curly"] if female else ["short", "spiky", "curly", "short", "bald_ring"]
	var cols := ["e8574a", "3f7cc2", "3aa86b", "f2c230", "8e44ad", "e0752d", "2c3e50", "f4f4f4", "c0392b", "16a085"]
	var top: String = tops[rng.randi() % tops.size()]
	var age := rng.randf()
	var look := {
		"height": rng.randf_range(1.6, 1.78) if female else rng.randf_range(1.7, 1.9),
		"girth": rng.randf_range(0.9, 1.3),
		"skin": HumanRig.SKIN_TONES[rng.randi() % HumanRig.SKIN_TONES.size()],
		"hair": hairs[rng.randi() % hairs.size()],
		"hair_color": HumanRig.HAIR_COLORS[rng.randi() % (8 if age > 0.8 else 6)],
		"top": top, "top_color": cols[rng.randi() % cols.size()],
		"bottom": ["pants", "shorts", "skirt" if female else "pants"][rng.randi() % 3],
		"bottom_color": ["2a3a5a", "3a3a3a", "c8b48a", "5a4a3a"][rng.randi() % 4],
		"glasses": ["", "", "round", "square", "sun"][rng.randi() % 5],
		"hat": ["", "", "", "cap", "beanie", "bucket", "sunhat" if female else "flatcap"][rng.randi() % 7],
		"hat_color": cols[rng.randi() % cols.size()],
		"beard": "" if female else ["", "", "stubble", "full", "mustache"][rng.randi() % 5],
		"extras": [["", "backpack", "scarf", "necklace"][rng.randi() % 4]],
	}
	var kinds := [
		{"desc": "Genießt einfach den Tag im Park.", "likes": {"wander": 1.5, "sit": 1.2, "eat": 1.0, "chat": 1.2, "watch": 1.2}},
		{"desc": "Liest gern auf der Parkbank.", "likes": {"read": 2.0, "sit": 1.0, "eat": 0.8, "wander": 0.6}},
		{"desc": "Joggt ab und zu eine Runde.", "likes": {"jog": 1.6, "wander": 0.8, "sit": 0.6, "eat": 0.6}},
		{"desc": "Ist zum Fotografieren hier.", "likes": {"photo": 1.6, "wander": 1.0, "eat": 1.0, "watch": 1.0}},
		{"desc": "Füttert gern die Enten.", "likes": {"feed_ducks": 1.6, "sit": 1.0, "wander": 0.8, "chat": 1.0}},
	]
	var k: Dictionary = kinds[rng.randi() % kinds.size()]
	var start := rng.randi_range(7, 14)
	return {"id": "visitor_%d" % i, "name": "Besucher%s %s" % ["in" if female else "", name], "desc": k["desc"],
		"role": "visitor", "walk": rng.randf_range(1.05, 1.4), "hours": [[start, start + rng.randi_range(4, 9)]],
		"likes": k["likes"], "look": look}


## Passer-by of the Oststadt (taxi fares come from them).
static func city_person(i: int, rng: RandomNumberGenerator) -> Dictionary:
	var d := visitor(i, rng)
	var name: String = CITY_NAMES[i % CITY_NAMES.size()]
	d["id"] = "citizen_%d" % i
	d["name"] = "%s %s" % ["Passantin" if i % 2 == 0 else "Passant", name]
	d["desc"] = ["Wohnt in der Oststadt.", "Ist auf dem Weg zum Bäcker.", "Sucht einen Parkplatz.", "Geht gern über den Marktplatz."][i % 4]
	d["city"] = true
	d["likes"] = {"wander": 1.8, "sit": 1.0, "eat": 1.0, "chat": 1.2}
	var start := rng.randi_range(7, 12)
	d["hours"] = [[start, start + rng.randi_range(7, 10)]]
	return d


## Children of the Oststadt (they run to the ice cream van).
static func city_kid(i: int, rng: RandomNumberGenerator) -> Dictionary:
	var cols := ["e8574a", "3f7cc2", "3aa86b", "f2c230", "8e44ad"]
	var girl := i % 2 == 1
	return {"id": "kid_%d" % i, "name": "Kind %s" % KID_NAMES[i % KID_NAMES.size()], "desc": "Wohnt in der Oststadt. Liebt Eis.",
		"role": "kid", "city": true, "walk": 1.3, "run": 3.6, "rates": {"fatigue": 0.6, "hunger": 1.2},
		"hours": [[9, 19]], "likes": {"wander": 2.0, "sit": 0.4, "eat": 0.8, "chat": 0.6},
		"look": {"child": true, "height": rng.randf_range(1.1, 1.3), "skin": HumanRig.SKIN_TONES[rng.randi() % HumanRig.SKIN_TONES.size()],
			"hair": "pigtails" if girl else "short", "hair_color": HumanRig.HAIR_COLORS[rng.randi() % 5],
			"top": "tshirt", "top_color": cols[rng.randi() % cols.size()], "bottom": "shorts", "bottom_color": "3a4a6a", "blush": true}}


## Visitor of the Kirmes in the Westpark: strolls, eats, watches the showmen, rides.
static func fair_visitor(i: int, rng: RandomNumberGenerator) -> Dictionary:
	var d := visitor(i + 3, rng)
	var name: String = FAIR_NAMES[i % FAIR_NAMES.size()]
	var female := (i + 3) % 2 == 0
	d["id"] = "fairgoer_%d" % i
	d["name"] = "Besucher%s %s" % ["in" if female else "", name]
	d["desc"] = ["Ist zum ersten Mal auf der Kirmes.", "Kommt jedes Wochenende her.", "Will unbedingt aufs Riesenrad.",
		"Ist wegen der gebrannten Mandeln hier.", "Sucht den Autoscooter."][i % 5]
	d["fair"] = true
	d["likes"] = {"wander": 1.6, "eat": 1.4, "sit": 0.9, "watch": 1.8, "chat": 1.1}
	var start := rng.randi_range(10, 16)
	d["hours"] = [[start, mini(start + rng.randi_range(4, 7), 23)]]
	return d


## Children at the Kirmes.
static func fair_kid(i: int, rng: RandomNumberGenerator) -> Dictionary:
	var d := city_kid(i, rng)
	d["id"] = "fairkid_%d" % i
	d["name"] = "Kind %s" % FAIR_KID_NAMES[i % FAIR_KID_NAMES.size()]
